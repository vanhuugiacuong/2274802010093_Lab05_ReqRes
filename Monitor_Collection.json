{
  "info": {
    "_postman_id": "edbbfd78-27ca-4d08-a57b-e931fea7216b",
    "name": "MSSV_HoTen_ReqRes_Monitor",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "x-api-key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "GET - List Users (Monitor)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Availability: Status code is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"SLA: Response time < 800ms\", () => pm.expect(pm.response.responseTime).to.be.below(800));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users?page=1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            }
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://reqres.in"
    }
  ]
}