  "item": [
    {
      "name": "Positive_Cases",
      "item": [
        {
          "name": "1. POST - Register User / Get Auth Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response có token\", () => pm.expect(pm.response.json().token).to.be.a(\"string\").and.not.empty);",
                  "pm.environment.set(\"userToken\", pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"eve.holt@reqres.in\",\n    \"password\": \"pistol\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "2. POST - Create User (DDT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"name khớp dữ liệu CSV\", () => pm.expect(res.name).to.eql(pm.iterationData.get(\"name\")));",
                  "pm.test(\"job khớp dữ liệu CSV\", () => pm.expect(res.job).to.eql(pm.iterationData.get(\"job\")));",
                  "pm.test(\"Có id trả về\", () => pm.expect(res.id).to.exist);",
                  "pm.environment.set(\"userId\", res.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"{{name}}\",\n    \"job\": \"{{job}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            }
          },
          "response": []
        },
        {
          "name": "3. GET - Single User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json().data;",
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"data.id bằng 2\", () => pm.expect(data.id).to.eql(2));",
                  "pm.test(\"data.email chứa @reqres.in\", () => pm.expect(data.email).to.include(\"@reqres.in\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
